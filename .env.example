# -------------------------------------------------------------
# GOAT BAR SYSTEM - ENVIRONMENT VARIABLES TEMPLATE
# -------------------------------------------------------------

# Supabase Client (Frontend & SSR)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Edge Functions Secrets (Set via Supabase Dashboard or CLI)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# -------------------------------------------------------------
# GOAT AI - GEMINI & HEURISTIC CONFIGURATION
# -------------------------------------------------------------
# Google AI Studio API Key for Gemini Provider
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Explicit fallback policy: set to "true" to allow heuristic extraction
# when GEMINI_API_KEY is not configured (recommended in dev/test, false in strict prod)
GOAT_AI_ALLOW_HEURISTIC_FALLBACK="true"

# -------------------------------------------------------------
# GOAT AI - WHATSAPP BUSINESS CLOUD API
# -------------------------------------------------------------
# Meta Graph API permanent access token with whatsapp_business_messaging scope
WHATSAPP_ACCESS_TOKEN=""

# Meta Phone Number ID (from Meta Developer App -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=""

# Meta WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Webhook Verification Token (custom secret chosen for webhook setup)
WHATSAPP_VERIFY_TOKEN="goatbar_verify_token"

# Meta App Secret (for HMAC-SHA256 signature verification in webhook)
WHATSAPP_APP_SECRET=""
